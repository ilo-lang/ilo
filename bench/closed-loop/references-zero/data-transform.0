pub fn main(world: World) -> Void raises {
    let xs: [5]i32 = [1, 2, 3, 4, 5]
    var total: i32 = 0
    var i: i32 = 0
    while i < 5 {
        let sq: i32 = xs[i] * xs[i]
        if sq > 10 {
            total = total + sq
        }
        i = i + 1
    }
    var out: [12]u8 = [0_u8; 12]
    let m: Maybe<Span<u8>> = std.fmt.i32(out, total)
    if m.has {
        check world.out.write(m.value)
    }
}
