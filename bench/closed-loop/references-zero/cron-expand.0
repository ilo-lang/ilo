// Expand the cron range-list field "1-3,7,9-10" into the explicit
// ascending list of integers it denotes.
pub fn main(world: World) -> Void raises {
    let field: Span<u8> = std.mem.span("1-3,7,9-10")
    let n: usize = std.mem.len(field)
    var i: usize = 0
    var start: usize = 0
    var first: Bool = true
    var out: [12]u8 = [0_u8; 12]
    while i <= n {
        if i == n || field[i] == 44_u8 {
            let tok: Span<u8> = std.mem.slice(field, start, i - start)
            let tn: usize = std.mem.len(tok)
            var dash: usize = tn
            var k: usize = 0
            while k < tn {
                if tok[k] == 45_u8 {
                    dash = k
                }
                k = k + 1
            }
            var lo: i32 = 0
            var hi: i32 = 0
            if dash == tn {
                let m: Maybe<i32> = std.parse.parseI32(tok)
                if m.has {
                    lo = m.value
                    hi = m.value
                }
            } else {
                let a: Maybe<i32> = std.parse.parseI32(std.mem.slice(tok, 0, dash))
                let b: Maybe<i32> = std.parse.parseI32(std.mem.slice(tok, dash + 1, tn - dash - 1))
                if a.has && b.has {
                    lo = a.value
                    hi = b.value
                }
            }
            var v: i32 = lo
            while v <= hi {
                if first {
                    first = false
                } else {
                    check world.out.write(" ")
                }
                let pm: Maybe<Span<u8>> = std.fmt.i32(out, v)
                if pm.has {
                    check world.out.write(pm.value)
                }
                v = v + 1
            }
            start = i + 1
        }
        i = i + 1
    }
    check world.out.write("\n")
}
