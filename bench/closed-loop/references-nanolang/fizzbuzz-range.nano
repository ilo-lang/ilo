# Task: fizzbuzz-range — classic FizzBuzz over 1..15, joined by commas
fn fizzbuzz(n: int) -> string {
    if (and (== (% n 3) 0) (== (% n 5) 0)) {
        return "FizzBuzz"
    }
    if (== (% n 3) 0) {
        return "Fizz"
    }
    if (== (% n 5) 0) {
        return "Buzz"
    }
    return (int_to_string n)
}

shadow fizzbuzz {
    assert (str_equals (fizzbuzz 15) "FizzBuzz")
    assert (str_equals (fizzbuzz 9) "Fizz")
    assert (str_equals (fizzbuzz 10) "Buzz")
    assert (str_equals (fizzbuzz 7) "7")
}

fn join_fizzbuzz(lo: int, hi: int) -> string {
    let mut out: string = ""
    let mut i: int = lo
    while (<= i hi) {
        if (> i lo) {
            set out (str_concat out ",")
        }
        set out (str_concat out (fizzbuzz i))
        set i (+ i 1)
    }
    return out
}

shadow join_fizzbuzz {
    assert (str_equals (join_fizzbuzz 1 3) "1,2,Fizz")
    assert (str_equals (join_fizzbuzz 5 5) "Buzz")
}

fn main() -> int {
    (println (join_fizzbuzz 1 15))
    return 0
}

shadow main {
    assert (== (main) 0)
}
