# Task: dedupe-order — keep first occurrence of each value in [3,1,3,2,1,4]
fn contains(xs: array<int>, v: int) -> bool {
    let mut i: int = 0
    while (< i (array_length xs)) {
        if (== (at xs i) v) {
            return true
        }
        set i (+ i 1)
    }
    return false
}

shadow contains {
    let xs: array<int> = [3, 1, 2]
    assert (== (contains xs 1) true)
    assert (== (contains xs 4) false)
    assert (== (contains [] 1) false)
}

fn dedupe(xs: array<int>) -> array<int> {
    let mut out: array<int> = []
    let mut i: int = 0
    while (< i (array_length xs)) {
        let v: int = (at xs i)
        if (not (contains out v)) {
            set out (array_push out v)
        }
        set i (+ i 1)
    }
    return out
}

shadow dedupe {
    let out: array<int> = (dedupe [3, 1, 3, 2, 1, 4])
    assert (== (array_length out) 4)
    assert (== (at out 0) 3)
    assert (== (at out 3) 4)
    assert (== (array_length (dedupe [])) 0)
}

fn main() -> int {
    let out: array<int> = (dedupe [3, 1, 3, 2, 1, 4])
    let mut line: string = ""
    let mut i: int = 0
    while (< i (array_length out)) {
        if (> i 0) {
            set line (str_concat line " ")
        }
        set line (str_concat line (int_to_string (at out i)))
        set i (+ i 1)
    }
    (println line)
    return 0
}

shadow main {
    assert (== (main) 0)
}
