# Task: kmeans-assign — 1-D points to centroids 2 and 11, then cluster means
fn nearer(p: int, c0: int, c1: int) -> int {
    let d0: int = (abs (- p c0))
    let d1: int = (abs (- p c1))
    if (<= d0 d1) {
        return 0
    }
    return 1
}

shadow nearer {
    assert (== (nearer 1 2 11) 0)
    assert (== (nearer 10 2 11) 1)
    # tie goes to the first centroid
    assert (== (nearer 7 2 12) 0)
}

fn fmt2(x: float) -> string {
    let cents: int = (cast_int (round (* x 100.0)))
    let frac: int = (% cents 100)
    let mut frac_s: string = (int_to_string frac)
    if (< frac 10) {
        set frac_s (str_concat "0" frac_s)
    }
    return (str_concat (str_concat (int_to_string (/ cents 100)) ".") frac_s)
}

shadow fmt2 {
    assert (str_equals (fmt2 2.0) "2.00")
    assert (str_equals (fmt2 11.0) "11.00")
    assert (str_equals (fmt2 6.75) "6.75")
}

fn main() -> int {
    let pts: array<int> = [1, 2, 3, 10, 11, 12]
    let mut line: string = ""
    let mut sums: array<int> = [0, 0]
    let mut counts: array<int> = [0, 0]
    let mut i: int = 0
    while (< i (array_length pts)) {
        let p: int = (at pts i)
        let c: int = (nearer p 2 11)
        if (> i 0) {
            set line (str_concat line ",")
        }
        set line (str_concat line (int_to_string c))
        (array_set sums c (+ (at sums c) p))
        (array_set counts c (+ (at counts c) 1))
        set i (+ i 1)
    }
    (println line)
    (println (str_concat "c0=" (fmt2 (/ (cast_float (at sums 0)) (cast_float (at counts 0))))))
    (println (str_concat "c1=" (fmt2 (/ (cast_float (at sums 1)) (cast_float (at counts 1))))))
    return 0
}

shadow main {
    assert (== (main) 0)
}
