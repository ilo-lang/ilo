# Task: csv-aggregate — sum amount per region, alphabetical, 2 decimals
# str_split is unreliable under bin/nano (interpreter), so fields are split
# manually; floats are formatted from integer cents (float_to_string is %g).
fn fmt2(x: float) -> string {
    let cents: int = (cast_int (round (* x 100.0)))
    let frac: int = (% cents 100)
    let mut frac_s: string = (int_to_string frac)
    if (< frac 10) {
        set frac_s (str_concat "0" frac_s)
    }
    return (str_concat (str_concat (int_to_string (/ cents 100)) ".") frac_s)
}

shadow fmt2 {
    assert (str_equals (fmt2 17.0) "17.00")
    assert (str_equals (fmt2 6.75) "6.75")
    assert (str_equals (fmt2 3.0) "3.00")
}

fn split_char(s: string, sep: string) -> array<string> {
    let mut parts: array<string> = []
    let seplen: int = (str_length sep)
    let mut rest: string = s
    let mut idx: int = (str_index_of rest sep)
    while (>= idx 0) {
        set parts (array_push parts (str_substring rest 0 idx))
        set rest (str_substring rest (+ idx seplen) (str_length rest))
        set idx (str_index_of rest sep)
    }
    set parts (array_push parts rest)
    return parts
}

shadow split_char {
    let parts: array<string> = (split_char "east,10.5" ",")
    assert (== (array_length parts) 2)
    assert (str_equals (at parts 0) "east")
    assert (str_equals (at parts 1) "10.5")
}

fn index_of_word(words: array<string>, w: string) -> int {
    let mut i: int = 0
    while (< i (array_length words)) {
        if (str_equals (at words i) w) {
            return i
        }
        set i (+ i 1)
    }
    return -1
}

shadow index_of_word {
    let ws: array<string> = ["east", "west"]
    assert (== (index_of_word ws "west") 1)
    assert (== (index_of_word ws "north") -1)
}

fn region_total(rows: array<string>, region: string) -> float {
    let mut total: float = 0.0
    let mut i: int = 0
    while (< i (array_length rows)) {
        let fields: array<string> = (split_char (at rows i) ",")
        if (str_equals (at fields 0) region) {
            set total (+ total (string_to_float (at fields 1)))
        }
        set i (+ i 1)
    }
    return total
}

shadow region_total {
    let rows: array<string> = ["east,10.5", "west,4.25", "east,6.5"]
    assert (== (region_total rows "east") 17.0)
    assert (== (region_total rows "west") 4.25)
}

fn main() -> int {
    let rows: array<string> = (split_char "east,10.5\nwest,4.25\neast,6.5\nnorth,3.0\nwest,2.5" "\n")
    let mut regions: array<string> = []
    let mut i: int = 0
    while (< i (array_length rows)) {
        let fields: array<string> = (split_char (at rows i) ",")
        let region: string = (at fields 0)
        if (< (index_of_word regions region) 0) {
            set regions (array_push regions region)
        }
        set i (+ i 1)
    }
    let sorted: array<string> = (array_sort regions)
    set i 0
    while (< i (array_length sorted)) {
        let region: string = (at sorted i)
        (println (str_concat (str_concat region ": ") (fmt2 (region_total rows region))))
        set i (+ i 1)
    }
    return 0
}

shadow main {
    assert (== (main) 0)
}
