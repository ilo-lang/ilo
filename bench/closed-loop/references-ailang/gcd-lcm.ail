-- gcd-lcm: gcd(48,18) = 6; lcm = 48*18/6 = 144.
-- Run: ailang run -quiet --caps IO gcd-lcm.ail
module bench/gcd_lcm

import std/io (println)

pure func gcd(a: int, b: int) -> int {
  if b == 0 then a else gcd(b, a % b)
}

export func main() -> () ! {IO} {
  let g = gcd(48, 18)
  let l = 48 * 18 / g
  println("gcd=${show(g)}")
  println("lcm=${show(l)}")
}
