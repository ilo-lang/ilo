-- dedupe-order: [3,1,3,2,1,4] -> 3 1 2 4 (first occurrence kept, order preserved).
-- Run: ailang run -quiet --caps IO dedupe-order.ail
module bench/dedupe_order

import std/io (println)
import std/list (foldl, concat, any, map)
import std/string (intToStr, join)

pure func seen(xs: [int], x: int) -> bool {
  any(\y. y == x, xs)
}

pure func dedupe(xs: [int]) -> [int] {
  foldl(\acc. \x. if seen(acc, x) then acc else concat(acc, [x]), [], xs)
}

export func main() -> () ! {IO} {
  let unique = dedupe([3, 1, 3, 2, 1, 4])
  println(join(" ", map(intToStr, unique)))
}
