-- api-rate-limit-watcher: adaptive rate-limit throttling demo.
-- Loop N times with simulated rate-limit state. Demonstrates:
-- - Loop with mutable state (remaining quota)
-- - Conditional sleep based on threshold
-- - Per-iteration logging of decisions

watch-api>_;
  cur-now=now;
  reset-epoch=+cur-now 3600;
  i=0;
  remaining=10;
  wh <i 3{
    prnt cat ["[" (str i) "] Remaining: " (str remaining) "/10"] "";
    remaining<5{
      wait-ms=rou *(-reset-epoch cur-now) 1000;
      prnt cat ["Throttling " (str wait-ms) "ms"] "";
      sleep wait-ms
    }{prnt "OK"};
    remaining=max 0 -remaining 1;
    i=+i 1
  }

-- run: watch-api
-- out: (unit)
