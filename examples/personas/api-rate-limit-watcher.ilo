-- api-rate-limit-watcher: adaptive rate-limit throttling demo.
-- Simulates polling GitHub API with rate-limit header tracking.
-- Demonstrates: loop with state, conditional sleep, per-request logging.
-- Cross-engine, ≤200 LoC, no Python.

^26.5

-- Entry: loop 3 times, each call manages rate-limit state.
watch-api;
  now=now;
  reset-epoch=(+now 3600);
  remaining=10;
  limit=10;
  i=0;
  @loop{
    i>=3?!;
    ?poll-once i remaining limit reset-epoch now{
      ~ok:new-remaining;
        remaining=new-remaining;
        i=+i 1;
        @loop;
      ~err:e;
        prnt "Poll failed: " e;
        !
    }
  }

-- Single poll: log state, check throttle threshold, sleep if needed, return updated remaining.
poll-once iter:n remaining:n limit:n reset:n now:n>R n t;
  threshold=5;

  -- Log current state.
  log-action iter remaining limit;

  -- If remaining is low, sleep until reset.
  remaining<threshold?
    wait-sec=max 0 (-reset now);
    sleep (round (*wait-sec 1000))
  :
    _;

  -- Decrement and return updated state.
  Ok (max 0 (-remaining 1))

-- Log one request line: iteration, remaining quota, limit, wait recommendation.
log-action iter:n remaining:n limit:n>_;
  msg="[" (str iter) "] Remaining: " (str remaining) "/" (str limit) " → ";
  remaining<5?
    prnt msg "throttle active"
  :
    prnt msg "ok"

-- run: watch-api
-- out: (unit)
