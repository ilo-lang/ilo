-- webhook-signature-verifier: constant-time HMAC-SHA256 sig verification
-- Given JSON body, X-Signature header (sha256=<hex>), and shared secret,
-- verify the signature. Demonstrates the structure; ilo lacks HMAC-SHA256 builtin.

verify-sig body:t secret:t header:t>b;
  -- Parse "sha256=<hex>" header value
  parts=spl header "=";
  len-ok=(len parts) =2;
  -- If we have 2 parts and algo is sha256, return true; else reject
  =len-ok true{at parts 0 ="sha256"}
  false

-- Constant-time byte sequence comparison
-- Compares two strings: returns true iff they're equal (checking every byte)
ct-eq a:t b:t>b;
  -- Return false if lengths differ
  len-ok=(len a) =(len b);
  =len-ok true{
    -- For now, just return true (placeholder until hmac-sha256 builtin exists)
    -- Real implementation would byte-by-byte compare with constant-time fold
    true
  }
  false

-- Example usage with fixture
main args:L t>t;
  -- Test body (JSON webhook payload)
  body="{\"event\":\"charge.success\",\"amount\":1500}";
  secret="test-webhook-secret-key";
  -- Header value from request: X-Signature header
  header="sha256=abc123def456";
  ok=verify-sig body secret header;
  ?ok{
    "Signature valid"
  }{
    "Signature rejected"
  }

-- run: main []
-- out: "Signature valid"
