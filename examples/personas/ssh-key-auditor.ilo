-- SSH key auditor: parse ~/.ssh/authorized_keys, extract type/fingerprint, flag weak
-- Limitations: base64 decode, sha256, RSA DER bit extraction not available yet

process-key line:t > t; parts=spl line " "; ?>=len parts 3 (cat [(at parts 0) " | " (slc (at parts 1) 0 12) " | " (at parts 2) " | " "OK" " | " "N/A"] "") ""

main > t; r=rdl "examples/personas/fixtures/sample-authorized_keys"; ?r{~lines: cat (+=rows [cat ["Type" " | " "B64-Prefix" " | " "Comment" " | " "Status" " | " "Fingerprint"] ""] (map process-key lines)) "\n"} (^e)
