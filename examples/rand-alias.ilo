-- `rand` is a long-form alias for the canonical `rnd` random builtin.
-- It matches the universal short-form across C, Python, Rust, Go and JS,
-- and disambiguates the round-vs-random trap that event-trace-analyser
-- rerun11 surfaced: agents read `rnd` as drop-vowels-of-round and reach
-- for it when they want rounding. The unambiguous choice for random is
-- now `rand`; the unambiguous choice for round is `rou` (alias `round`).
--
-- `rand` resolves to `rnd` after parsing, so the bytecode and behaviour
-- are identical on every engine.

-- Zero-arg form: random float in [0, 1).
-- Probe shape only — we can't assert the value, so check the range.
rand-in-unit-interval>b;x=rand;a=?>=x 0 1 0;b=?<x 1 1 0;t=*a b;=t 1

-- Two-arg form: random integer in [a, b] inclusive.
-- Sample 50 dice rolls and confirm every value lands in [1, 6].
dice-in-range>b;ok=1;@i 0..50{r=rand 1 6;lo=?>=r 1 1 0;hi=?<=r 6 1 0;in=*lo hi;ok=*ok in};=ok 1

-- Disambiguation: `rou`/`round` is the rounder. `rand`/`random`/`rnd` is random.
-- This call must return 4 (banker's rounding of 3.7), not a random float.
rounding-uses-rou>n;rou 3.7

-- run: rand-in-unit-interval
-- out: true
-- run: dice-in-range
-- out: true
-- run: rounding-uses-rou
-- out: 4
