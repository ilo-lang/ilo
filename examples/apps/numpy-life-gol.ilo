-- Conway's Game of Life on a 20x20 grid for 10 generations.
-- Grid stored flat: L n of length 400, index r*20+c. 0=dead, 1=alive.
-- Prints first grid, blank line, last grid. "#" alive, "." dead.

-- Set index i of a flat list to v by rebuilding.
-- (list mset isn't a builtin; only map mset is, and that's a different beast.)
setat xs:L n i:n v:n>L n;ys=[];@k 0..len xs{=k i{ys=+=ys v}{ys=+=ys at xs k}};ys

-- Count live neighbours of cell (r,c) by scanning 8 offsets.
-- Off-grid neighbours count as 0.
nbr g:L n r:n c:n>n;s=0;@dr 0..3{@dc 0..3{rr=+r -dr 1;cc=+c -dc 1;skip=&(=dr 1) =dc 1;ok=&(&(>=rr 0) <rr 20) &(>=cc 0) <cc 20;&(!skip) ok{i=+*rr 20 cc;s=+s at g i}};s=+s 0};+s 0

-- Step the whole grid one generation.
step g:L n>L n;ng=[];@r 0..20{@c 0..20{n=nbr g r c;v=at g +*r 20 c;alive=&(=v 1) |(=n 2) =n 3;born=&(=v 0) =n 3;|alive born{ng=+=ng 1}{ng=+=ng 0}}};ng

-- Render grid: 20 rows joined by newlines, cells "." or "#".
shw g:L n>t;rows=[];@r 0..20{cells=[];@c 0..20{v=at g +*r 20 c;=v 1{cells=+=cells "#"}{cells=+=cells "."}};rows=+=rows cat cells ""};cat rows "\n"

-- Initial grid: 400 zeros with a glider in the top-left corner.
init>L n;g=[];@i 0..400{g=+=g 0};g=setat g 1 1;g=setat g 22 1;g=setat g 40 1;g=setat g 41 1;g=setat g 42 1;g

-- Main: render first, step 10x, render last, join with blank line.
main>t;g=init;a=shw g;@gen 0..10{g=step g};b=shw g;cat [a "" b] "\n"

