-- batch-loop-orchestration rerun11 (fresh)
-- N independent tasks, per-task can fail.
-- Three strategies: mapr (first-Err), map+partition (collect both), @-loop mutate.

-- process: id -> R t t. Fails on multiples of 13.
proc i:n>R t t;m=mod i 13;?(=m 0){true:^(fmt "task {} failed" i);false:~(fmt "task {} ok" i)}

-- happy: ids 1..10, none fail
happy>R (L t) t;ids=range 1 11;mapr proc ids

-- bail: ids 1..20, fails at 13
bail>R (L t) t;ids=range 1 21;mapr proc ids

-- partition successes from failures across 1..30
-- mget returns O L _ so we unwrap with ?? before +=
both>L (L t);ids=range 1 31;rs=map proc ids;oks=[];ers=[];@r rs{?r{~v:oks=+=oks v;^e:ers=+=ers e}};[oks ers]

-- @-loop with cond{body} mutate-and-continue: count errs across 1..100
errs>n;ids=range 1 101;c=0;@i ids{r=proc i;?r{~_:c=c;^_:c=+c 1}};c

-- @-loop with cond{body} early-return via ret: first failing id, or 0
first-fail>n;ids=range 1 101;@i ids{r=proc i;?r{~_:0;^_:ret i}};0

-- run: happy
-- out: ["task 1 ok", "task 2 ok", "task 3 ok", "task 4 ok", "task 5 ok", "task 6 ok", "task 7 ok", "task 8 ok", "task 9 ok", "task 10 ok"]
-- run: bail
-- err: ^task 13 failed
-- run: errs
-- out: 7
-- run: first-fail
-- out: 13
