-- analytics.ilo: top customers, top products, revenue by category, stats
-- uses inline-mset form to avoid the 0.12.0 helper-fn cliff
parsen s:t>n;
  r=num s;
  ?r{~v:v;^_:0.0}

negval pair:L t>n;
  - 0 (parsen (at pair 1))

main >R t t;
  rows=rd! "orders.csv";
  body=drop 1 rows;
  n=len body;
  prnt cat ["rows: " str n] "";

  -- aggregations: topcust, topprod, revcat all inline
  mc=mmap;
  mp=mmap;
  mg=mmap;
  rs=[];
  @row body{
    cid=at row 1;
    pid=at row 2;
    cg=at row 3;
    q=parsen (at row 4);
    p=parsen (at row 5);
    r=*q p;
    rs=+=rs r;
    pc=??(mget mc cid) 0;
    mc=mset mc cid (+pc r);
    pp=??(mget mp pid) 0;
    mp=mset mp pid (+pp r);
    pg=??(mget mg cg) 0;
    mg=mset mg cg (+pg r)
  };

  prnt cat ["total rev: " str (sum rs)] "";
  prnt cat ["mean order rev: " (fmt2 (avg rs) 4)] "";
  prnt cat ["median order rev: " (fmt2 (median rs) 4)] "";
  prnt cat ["p95 order rev: " (fmt2 (quantile rs 0.95) 4)] "";
  prnt cat ["stdev order rev: " (fmt2 (stdev rs) 4)] "";
  prnt cat ["distinct customers: " str len mc] "";
  prnt cat ["distinct products: " str len mp] "";
  prnt cat ["categories: " str len mg] "";

  -- top 5 customers by spend
  ks=mkeys mc;
  pairs=[];
  @k ks{
    v=??(mget mc k) 0;
    pairs=+=pairs [k str v]
  };
  -- sort by numeric value desc
  byval=srt negval pairs;
  top5=take 5 byval;
  prnt "top 5 customers:";
  @e top5{prnt cat [at e 0 " -> " at e 1] ""};

  -- revenue by category
  prnt "revenue by category:";
  @k mkeys mg{
    v=??(mget mg k) 0;
    prnt cat [k " -> " (fmt2 v 2)] ""
  };

  ~"ok"
