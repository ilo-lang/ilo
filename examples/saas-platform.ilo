-- SaaS platform: user management, billing, notifications, analytics
-- 30 functions, 10 types — realistic multi-domain program

-- === TYPES ===

type user{id:t;email:t;name:t;plan:t;created:n;active:b}
type team{id:t;name:t;owner:t;members:L t;plan:t}
type invoice{id:t;user-id:t;amount:n;status:t;due:n;items:L line-item}
type line-item{desc:t;qty:n;rate:n}
type payment{id:t;invoice-id:t;amount:n;method:t;ts:n}
type usage{user-id:t;feature:t;count:n;period:t}
type plan{name:t;price:n;limits:L limit}
type limit{feature:t;max:n}
type notification{to:t;subject:t;body:t;channel:t}
type event{user-id:t;action:t;ts:n;meta:t}

-- === VALIDATION ===

vld-email em:t>R t t
  ?has em "@"{~em}{^"invalid email"}

vld-plan p:t>R t t
  ?has ["free","pro","enterprise"] p{~p}{^+"unknown plan: " p}

vld-user u:user>R user t
  vld-email! u.email
  vld-plan! u.plan
  ~u

-- === USER MANAGEMENT ===

create-user email:t name:t plan:t>R user t
  vld-email! email
  vld-plan! plan
  ts=now
  uid=+"usr-" str ts
  ~user id:uid email:email name:name plan:plan created:ts active:true

update-plan u:user new-plan:t>R user t
  vld-plan! new-plan
  upd=u with plan:new-plan
  ~upd

deactivate u:user>user
  u with active:false

lookup-active users:L user>L user
  flt is-active users

is-active u:user>b
  u.active

-- === TEAM MANAGEMENT ===

create-team name:t owner:user>R team t
  ?owner.active{true:ts=now;tid=+"team-" str ts;~team id:tid name:name owner:owner.id members:[owner.id] plan:owner.plan;false:^"owner must be active"}

add-member tm:team u:user>R team t
  mem=has tm.members u.id
  ms=+tm.members [u.id]
  upd=tm with members:ms
  ?mem{true:^"already a member";false:~upd}

team-size tm:team>n
  len tm.members

-- === BILLING ===

line-total li:line-item>n
  *li.qty li.rate

invoice-total myinv:invoice>n
  sum map line-total myinv.items

create-invoice uid:t items:L line-item>R invoice t
  <=len items 0 ^"no items"
  ts=now
  iid=+"inv-" str ts
  tot=sum map line-total items
  dv=+ts 2592000
  ~invoice id:iid user-id:uid amount:tot status:"pending" due:dv items:items

pay-invoice myinv:invoice method:t>R payment t
  !=myinv.status "pending"{^+"cannot pay: " myinv.status}
  ts=now
  pid=+"pay-" str ts
  ~payment id:pid invoice-id:myinv.id amount:myinv.amount method:method ts:ts

is-overdue myinv:invoice>b
  ts=now
  &=myinv.status "pending" >ts myinv.due

overdue-invoices invoices:L invoice>L invoice
  flt is-overdue invoices

-- === USAGE TRACKING ===

track uid:t feature:t>usage
  ts=now
  prd=str ts
  usage user-id:uid feature:feature count:1 period:prd

aggregate usages:L usage>M t L usage
  grp by-feature usages

by-feature u:usage>t
  u.feature

check-limit u:usage p:plan>R b t
  lims=flt match-feature p.limits
  =len lims 0{ret ~true}
  lim=hd lims
  ~<=u.count lim.max

match-feature l:limit>b
  =l.feature "api"

-- === NOTIFICATIONS ===

email-notify to:t subject:t body:t>notification
  notification to:to subject:subject body:body channel:"email"

sms-notify to:t body:t>notification
  notification to:to subject:"" body:body channel:"sms"

notify-overdue myinv:invoice u:user>notification
  subj=+"Overdue: " myinv.id
  body=fmt "Invoice {} for ${} is overdue" myinv.id str myinv.amount
  email-notify u.email subj body

-- === ANALYTICS ===

log-event uid:t action:t>event
  ts=now
  event user-id:uid action:action ts:ts meta:""

count-events events:L event action:t>n
  len flt is-action events

is-action ev:event>b
  =ev.action "login"

active-users events:L event win:n>L t
  recent=flt in-window events
  unq map get-uid recent

in-window ev:event>b
  ts=now
  >ev.ts -ts 86400

get-uid ev:event>t
  ev.user-id

-- === ORCHESTRATION ===

onboard email:t name:t plan:t>R user t
  u=create-user! email name plan
  log-event u.id "signup"
  email-notify u.email "Welcome" +"Hi " name
  ~u

process-payment uid:t myinv:invoice method:t>R payment t
  p=pay-invoice! myinv method
  log-event uid "payment"
  email-notify uid "Payment received" +"Paid $" str myinv.amount
  ~p

monthly-billing u:user items:L line-item>R invoice t
  myinv=create-invoice! u.id items
  log-event u.id "invoice-created"
  ~myinv
