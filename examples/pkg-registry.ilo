-- pkg-registry.ilo
-- End-to-end demo of `ilo add` / `use "owner/repo"` package import.
--
-- This example requires an external package (`ilo add ilo-lang/ilo-example-package`)
-- so it cannot verify in a clean checkout. It is excluded from the verify-all
-- coverage pass via the `-- check-skip:` annotation below.
-- check-skip: requires `ilo add ilo-lang/ilo-example-package`
--
-- Step 1 — install the example package (one-time, writes ilo.lock):
--   ilo add ilo-lang/ilo-example-package
--
-- Step 2 — run this file:
--   ilo run examples/pkg-registry.ilo
--
-- Expected output:
--   hello, agent
--   QUIET
--   5
--   10

use "ilo-lang/ilo-example-package" [greet shout safe-div clamp]

main>_
  prnt greet "agent"
  prnt shout "quiet"
  r = safe-div 10 2
  ?r{ok(v):prnt str v;err(e):prnt e}
  prnt str clamp 15 0 10
